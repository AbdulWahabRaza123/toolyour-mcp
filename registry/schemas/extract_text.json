{
  "operationId": "extract_text",
  "gatewayPath": "/api/v1/extract",
  "method": "POST",
  "request": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "contentBase64",
          "mimeType",
          "filename"
        ],
        "properties": {
          "contentBase64": {
            "type": "string",
            "description": "Base64-encoded file content",
            "example": "JVBERi0xLjQK..."
          },
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "filename": {
            "type": "string",
            "example": "document.pdf"
          }
        }
      },
      {
        "type": "object",
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "type": "object",
            "required": [
              "contentBase64",
              "mimeType",
              "filename"
            ],
            "properties": {
              "contentBase64": {
                "type": "string",
                "description": "Base64-encoded file content",
                "example": "JVBERi0xLjQK..."
              },
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "filename": {
                "type": "string",
                "example": "document.pdf"
              }
            }
          }
        }
      }
    ],
    "description": "Send fields at the top level, or nested under `inputs`."
  },
  "response": {
    "type": "object",
    "required": [
      "contentBase64",
      "mimeType",
      "filename"
    ],
    "properties": {
      "contentBase64": {
        "type": "string",
        "description": "Base64-encoded file content",
        "example": "JVBERi0xLjQK..."
      },
      "mimeType": {
        "type": "string",
        "example": "application/pdf"
      },
      "filename": {
        "type": "string",
        "example": "document.pdf"
      }
    }
  },
  "responseHint": "Returns JSON response"
}