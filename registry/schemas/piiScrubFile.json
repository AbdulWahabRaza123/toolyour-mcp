{
  "operationId": "piiScrubFile",
  "gatewayPath": "/api/v1/text-intelligence/pii-scrub-file",
  "method": "POST",
  "request": {
    "type": "object",
    "required": [
      "file"
    ],
    "properties": {
      "file": {
        "type": "string",
        "format": "binary",
        "description": "Document to scrub (PDF, DOCX, TXT, etc. — max 10 MB)"
      },
      "redactEmails": {
        "type": "boolean",
        "default": true
      },
      "redactPhones": {
        "type": "boolean",
        "default": true
      },
      "redactNames": {
        "type": "boolean",
        "default": true
      },
      "redactOrganizations": {
        "type": "boolean",
        "default": false
      },
      "redactLocations": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "response": null,
  "responseHint": "Returns Python API envelope JSON"
}