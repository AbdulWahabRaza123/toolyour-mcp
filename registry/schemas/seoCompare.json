{
  "operationId": "seoCompare",
  "gatewayPath": "/api/v1/seo-tools/compare",
  "method": "POST",
  "request": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "yourUrl",
          "competitorUrl"
        ],
        "properties": {
          "yourUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://yoursite.com"
          },
          "competitorUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://competitor.com"
          }
        }
      },
      {
        "type": "object",
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "type": "object",
            "required": [
              "yourUrl",
              "competitorUrl"
            ],
            "properties": {
              "yourUrl": {
                "type": "string",
                "format": "uri",
                "example": "https://yoursite.com"
              },
              "competitorUrl": {
                "type": "string",
                "format": "uri",
                "example": "https://competitor.com"
              }
            }
          }
        }
      }
    ],
    "description": "Send fields at the top level, or nested under `inputs`."
  },
  "response": {
    "type": "object",
    "required": [
      "yourUrl",
      "competitorUrl"
    ],
    "properties": {
      "yourUrl": {
        "type": "string",
        "format": "uri",
        "example": "https://yoursite.com"
      },
      "competitorUrl": {
        "type": "string",
        "format": "uri",
        "example": "https://competitor.com"
      }
    }
  },
  "responseHint": "Returns JSON response"
}