{
  "operationId": "aiYoutubeInsight",
  "gatewayPath": "/api/v1/ai-models/youtube-insight",
  "method": "POST",
  "request": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "youtubeUrl",
          "prompt",
          "geminiApiKey"
        ],
        "properties": {
          "youtubeUrl": {
            "type": "string",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          },
          "prompt": {
            "type": "string",
            "example": "What are the main themes discussed?"
          },
          "geminiApiKey": {
            "type": "string",
            "description": "Required. Your Google Gemini API key (BYOK). Prefer header X-Gemini-Api-Key. Never logged or stored."
          }
        }
      },
      {
        "type": "object",
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "type": "object",
            "required": [
              "youtubeUrl",
              "prompt",
              "geminiApiKey"
            ],
            "properties": {
              "youtubeUrl": {
                "type": "string",
                "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
              },
              "prompt": {
                "type": "string",
                "example": "What are the main themes discussed?"
              },
              "geminiApiKey": {
                "type": "string",
                "description": "Required. Your Google Gemini API key (BYOK). Prefer header X-Gemini-Api-Key. Never logged or stored."
              }
            }
          }
        }
      }
    ],
    "description": "Send fields at the top level, or nested under `inputs`."
  },
  "response": {
    "type": "object",
    "required": [
      "youtubeUrl",
      "prompt",
      "geminiApiKey"
    ],
    "properties": {
      "youtubeUrl": {
        "type": "string",
        "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      },
      "prompt": {
        "type": "string",
        "example": "What are the main themes discussed?"
      },
      "geminiApiKey": {
        "type": "string",
        "description": "Required. Your Google Gemini API key (BYOK). Prefer header X-Gemini-Api-Key. Never logged or stored."
      }
    }
  },
  "responseHint": "Returns Node API envelope JSON"
}