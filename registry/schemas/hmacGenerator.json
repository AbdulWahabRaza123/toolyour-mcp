{
  "operationId": "hmacGenerator",
  "gatewayPath": "/api/v1/security-apis/hmac-generator",
  "method": "POST",
  "request": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "text",
          "secret"
        ],
        "properties": {
          "text": {
            "type": "string",
            "example": "payload"
          },
          "message": {
            "type": "string",
            "description": "Alias for text"
          },
          "secret": {
            "type": "string",
            "example": "shared-secret"
          },
          "key": {
            "type": "string",
            "description": "Alias for secret"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "sha1",
              "sha256",
              "sha384",
              "sha512"
            ],
            "default": "sha256"
          },
          "expected": {
            "type": "string",
            "description": "Optional expected digest for timing-safe compare"
          },
          "signature": {
            "type": "string",
            "description": "Alias for expected"
          }
        }
      },
      {
        "type": "object",
        "required": [
          "inputs"
        ],
        "properties": {
          "inputs": {
            "type": "object",
            "required": [
              "text",
              "secret"
            ],
            "properties": {
              "text": {
                "type": "string",
                "example": "payload"
              },
              "message": {
                "type": "string",
                "description": "Alias for text"
              },
              "secret": {
                "type": "string",
                "example": "shared-secret"
              },
              "key": {
                "type": "string",
                "description": "Alias for secret"
              },
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha1",
                  "sha256",
                  "sha384",
                  "sha512"
                ],
                "default": "sha256"
              },
              "expected": {
                "type": "string",
                "description": "Optional expected digest for timing-safe compare"
              },
              "signature": {
                "type": "string",
                "description": "Alias for expected"
              }
            }
          }
        }
      }
    ],
    "description": "Send fields at the top level, or nested under `inputs`."
  },
  "response": {
    "type": "object",
    "required": [
      "text",
      "secret"
    ],
    "properties": {
      "text": {
        "type": "string",
        "example": "payload"
      },
      "message": {
        "type": "string",
        "description": "Alias for text"
      },
      "secret": {
        "type": "string",
        "example": "shared-secret"
      },
      "key": {
        "type": "string",
        "description": "Alias for secret"
      },
      "algorithm": {
        "type": "string",
        "enum": [
          "sha1",
          "sha256",
          "sha384",
          "sha512"
        ],
        "default": "sha256"
      },
      "expected": {
        "type": "string",
        "description": "Optional expected digest for timing-safe compare"
      },
      "signature": {
        "type": "string",
        "description": "Alias for expected"
