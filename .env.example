# toolyour-mcp
PORT=3090
GATEWAY_URL=http://127.0.0.1:8888
SAAS_VALIDATE_URL=http://127.0.0.1:3002/internal/validate-key
# FEATURE_MEMORY_URL=http://127.0.0.1:3002/internal/feature-memory
SAAS_INTERNAL_SECRET=
LOG_LEVEL=info
MCP_SERVER_VERSION=1.0.0

# Open observability (optional; no proprietary APM required)
# OTEL_LOG_SPANS=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional overrides (defaults resolve relative to dist/)
# REGISTRY_PATH=../registry/manifest.json
# SCHEMAS_DIR=../registry/schemas
# SKILLS_DIR=../skills
# WORKFLOWS_PATH=../registry/workflows.json
# TASKS_PATH=../registry/tasks.json
# CONTENT_ADAPTERS_PATH=../registry/content-adapters.json

# Transports (free, no paid vendors):
#   SSE:            GET  /mcp  + POST /mcp/messages
#   Streamable HTTP: POST/GET/DELETE /mcp/http
# Truncated payloads: GET /mcp/payloads/:id  or MCP tool fetch_payload
# Optional: Redis for multi-replica async get_run (falls back to in-process if unset/unreachable)
# REDIS_URL=redis://default:password@host:6379
# REDIS_PUBLIC_URL=
# Scale: gateway concurrency + acquire wait (defaults are safe for a single replica)
# GATEWAY_MAX_CONCURRENT=24
# GATEWAY_ACQUIRE_TIMEOUT_MS=30000
# Webhook URL is configured in the dashboard (optional; get_run always works without it)

# Skill loop + completion loop are always registered.
# CONTROL_PLANE_DATA_DIR=.data/control-plane
# CONTROL_PLANE_JOBS_DIR=experiments/jobs
# Generate tokens with: node scripts/control-plane-print-env.mjs
# Do not commit real values. Do not reuse a published example string.
# CONTROL_PLANE_START_TOKEN=
# CONTROL_PLANE_RUNNER_TOKEN=
# CONTROL_PLANE_APPROVE_TOKEN=  # human-only job_approve; never echo over MCP
# CONTROL_PLANE_SECRETS_DIR=  # default: OS temp /toolyour-control-plane
# CONTROL_PLANE_REQUIRE_HMAC=true  # optional; CLI always sends submitHmac
# CONTROL_PLANE_PLAYWRIGHT_TIMEOUT_MS=120000  # host CLI; MCP does not run Playwright
# Durable jobs (default file). saas talks to toolyour-saas /internal/control-plane/jobs — leave unset for the experiment.
# CONTROL_PLANE_JOBS_BACKEND=file
# CONTROL_PLANE_JOBS_URL=http://127.0.0.1:3002/internal/control-plane/jobs
# saas backend also requires ApiKey.controlPlane=true from validate-key.
